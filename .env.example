# Stripe test mode only — this app refuses to start a checkout with an
# sk_live_ key. Get sk_test_... from dashboard.stripe.com (toggle "Test
# mode" on) -> Developers -> API keys. Without this set, checkout falls
# back to the in-memory simulated payment (no real Stripe involved).
STRIPE_SECRET_KEY=

# Filled in during Phase 7, once there's a deployed URL to register the
# webhook against. For local testing before then: `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` prints a whsec_... to put here.
STRIPE_WEBHOOK_SECRET=

# The app's own base URL — server-only (used to build Stripe's success/
# cancel redirect URLs), so no NEXT_PUBLIC_ prefix: that would inline it
# into the client JS bundle for no reason. In prod, your deployed URL
# (e.g. https://your-app.vercel.app).
APP_URL=http://localhost:3000

# Postgres connection string. For local dev: `docker compose up -d`, then
# postgres://onetable:onetable@localhost:5433/onetable
# (port 5433, not Postgres's default 5432 — see docker-compose.yml)
# In prod: the connection string from Vercel Postgres (or Neon, or another
# standard Postgres provider) — no code changes needed, only this value.
DATABASE_URL=

# Memory gateway selection: DB-backed automatically once DATABASE_URL above
# is set. Set to `mock` to force the in-memory mock instead (e.g. no DB
# handy, or comparing behavior against it) — leave unset otherwise.
MEMORY_PROVIDER=

# Auth.js session/JWT signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# No ADMIN_SECRET — /admin is gated by a real users.is_admin session check
# (Phase 5). Flip a signed-up account to admin directly in Postgres:
#   update users set is_admin = true where email = '...';
