{
  "name": "onetable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:memory": "npx --yes tsx@4 --tsconfig tsconfig.json src/features/memory/verify.ts",
    "verify:xtrace": "npx --yes tsx@4 --tsconfig tsconfig.json src/features/memory/xtrace-smoke.ts"
  },
  "dependencies": {
    "@xtraceai/memory": "^0.6.0",
    "next": "16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
